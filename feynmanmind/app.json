{
  "expo": {
    "name": "FeynmanMind",
    "slug": "feynmanmind",
    "version": "2.14.0",
    "scheme": "feynmanmind",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feynmanmind.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.feynmanmind.app",
      "versionCode": 28,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4EBD6"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F4EBD6",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#26302B"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Rubik",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Rubik_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Rubik_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Rubik_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Rubik_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Rubik_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "FrankRuhl",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_700Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_800ExtraBold.ttf",
                    "weight": 800
                  },
                  {
                    "path": "./assets/fonts/FrankRuhlLibre_900Black.ttf",
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Amatic",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/AmaticSC_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Rubik_400Regular.ttf",
              "./assets/fonts/Rubik_500Medium.ttf",
              "./assets/fonts/Rubik_600SemiBold.ttf",
              "./assets/fonts/Rubik_700Bold.ttf",
              "./assets/fonts/Rubik_800ExtraBold.ttf",
              "./assets/fonts/FrankRuhlLibre_400Regular.ttf",
              "./assets/fonts/FrankRuhlLibre_500Medium.ttf",
              "./assets/fonts/FrankRuhlLibre_600SemiBold.ttf",
              "./assets/fonts/FrankRuhlLibre_700Bold.ttf",
              "./assets/fonts/FrankRuhlLibre_800ExtraBold.ttf",
              "./assets/fonts/FrankRuhlLibre_900Black.ttf",
              "./assets/fonts/AmaticSC_700Bold.ttf"
            ]
          }
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "useLegacyPackaging": true
          }
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
