+    # --- layered music: a set's stages in layers (bed, rhythm, melody), switched on the bar ---
+    # A set is <name>.layers.json in music/ (lib/layered_player.js reads it), its audio files
+    # beside it. The page plays every layer of the stage in step and fades layers in and out
+    # by the intensity; a stage change waits for the next bar line, which the table decides
+    # here (from the stage's own clock) so every player switches on the same beat.
+    LAYERS_LEAD = 4.5           # (seconds) the soonest bar line a change can land on: every page
+                                # hears of it first (they ask for the table's state every 4 s)
+
+    def layered_set(self, name: str) -> Optional[Dict[str, Any]]:
+        """A layered set's manifest by name (music/<name>.layers.json), or None."""
+        stem = score_music.slug(str(name))
+        for d in self.music_dirs():
+            f = d / f"{stem}.layers.json"
+            if f.is_file():
+                return json.loads(f.read_text(encoding="utf-8"))
+        return None
+
+    def set_layers(self, name: str, stage: Optional[str] = None, intensity: Optional[str] = None,
+                   via: Optional[str] = None, cue: Optional[str] = None) -> Dict[str, Any]:
+        """Play a layered set, or move the one playing on: to a stage (on the next bar line;
+        through a cue that rises into it, ``via``), to an intensity (its layers fade), or to
+        a one-shot cue (an ending: on the next bar line, the loop stops under it). Raises
+        ValueError for a set, stage, intensity or cue that isn't there."""
+        import math
+        man = self.layered_set(name)
+        if man is None:
+            raise ValueError(f"no layered set {name}: music/{score_music.slug(str(name))}.layers.json")
+        stages = {s["id"]: s for s in man.get("stages") or []}
+        cues = {c["id"]: c for c in man.get("cues") or []}
+        if not stages:
+            raise ValueError(f"the set {name} has no stages")
+        stage_id = None
+        if stage is not None:
+            stage_id = f"stage{stage}" if str(stage).isdigit() else str(stage)
+            if stage_id not in stages:
+                raise ValueError(f"no {stage_id} in {name} (it has {', '.join(stages)})")
+        if intensity is not None and intensity not in (man.get("intensities") or {}):
+            raise ValueError(f"no intensity {intensity} (one of {', '.join(man.get('intensities') or {})})")
+        for c in (via, cue):
+            if c is not None and c not in cues:
+                raise ValueError(f"no cue {c} in {name} (it has {', '.join(cues) or 'none'})")
+        set_name = score_music.slug(str(name))
+        now = time.time()
+        with self.lock:
+            m = self.music
+            playing = m.get("kind") == "layered" and m.get("src") == set_name and m.get("track")
+            if playing and m.get("cue") and cue is None:
+                playing = False                       # (it ended: anything after an ending starts it again)
+            if not playing:
+                self.music_revert = None
+                self.music = {"id": int(m.get("id", 0)) + 1, "track": f"layers:{set_name}", "kind": "layered",
+                              "src": set_name, "title": man.get("title") or set_name, "volume": 0.7,
+                              "loop": True, "mood": "boss", "boss": True, "layers": man,
+                              "stage": stage_id or next(iter(stages)), "intensity": intensity or "full",
+                              "started_at": now}
+            else:
+                m = dict(m)
+                cur = stages[m["stage"]]
+                bar = float(cur["barSeconds"])
+                e = now + self.LAYERS_LEAD - float(m["started_at"])
+                boundary = float(m["started_at"]) + max(0, math.ceil(e / bar)) * bar
+                if stage_id is not None and stage_id != m["stage"]:
+                    lands = boundary + (float(cues[via].get("landsAt") or cues[via]["seconds"]) if via else 0.0)
+                    m.update(stage=stage_id, started_at=lands, via=via, via_at=boundary if via else None)
+                    m.pop("cue", None)
+                if intensity is not None:
+                    m["intensity"] = intensity
+                if cue is not None:
+                    m["cue"] = {"id": cue, "at": boundary}
+                self.music = m
+            self._save_music()
