+def _layered_set(camp, name="horologe"):
+    """A layered set: music/<name>.layers.json and its (dummy) audio files."""
+    music = camp / "music"
+    music.mkdir(exist_ok=True)
+    man = {"title": "Horologe", "intensities": {"calm": ["bed"], "full": ["bed", "rhythm", "melody"]},
+           "stages": [{"id": f"stage{i}", "name": f"Stage {i}", "seconds": 60.0, "loopStart": 2.0,
+                       "bpm": 120, "beatsPerBar": 4, "barSeconds": 2.0,
+                       "layers": {k: f"{name}-stage{i}-{k}.ogg" for k in ("bed", "rhythm", "melody")}}
+                      for i in (1, 2)],
+           "cues": [{"id": "rise", "file": f"{name}-rise.ogg", "seconds": 5.0, "landsAt": 3.0, "to": "stage2"},
+                    {"id": "ending", "file": f"{name}-ending.ogg", "seconds": 8.0}]}
+    (music / f"{name}.layers.json").write_text(json.dumps(man))
+    for s in man["stages"]:
+        for f in s["layers"].values():
+            (music / f).write_bytes(b"\0" * 1024)
+    for c in man["cues"]:
+        (music / c["file"]).write_bytes(b"\0" * 1024)
+    return man
+
+
+def test_layered_music_switches_on_the_tables_bar_line(table):
+    _layered_set(table["camp"])
+    call = table["call"]
+    status, body = call("/api/gm/music", {"layers": "Horologe", "intensity": "calm"}, host=True)
+    m = body["music"]
+    assert status == 200 and m["kind"] == "layered" and m["stage"] == "stage1" and m["intensity"] == "calm"
+    assert m["layers"]["stages"][0]["layers"]["bed"] == "horologe-stage1-bed.ogg"
+    first_id, started = m["id"], m["started_at"]
+
+    # The intensity changes in place: the same track (no restart), its layers fade.
+    m = call("/api/gm/music", {"layers": "horologe", "intensity": "full"}, host=True)[1]["music"]
+    assert m["id"] == first_id and m["intensity"] == "full" and m["started_at"] == started
+
+    # A stage change lands on the playing stage's next bar line (2 s bars), through the rise.
+    m = call("/api/gm/music", {"layers": "horologe", "stage": 2, "via": "rise"}, host=True)[1]["music"]
+    assert m["id"] == first_id and m["stage"] == "stage2" and m["via"] == "rise"
+    bars = (m["via_at"] - started) / 2.0
+    assert abs(bars - round(bars)) < 1e-6 and m["via_at"] >= time.time()
+    assert abs(m["started_at"] - (m["via_at"] + 3.0)) < 1e-6          # where the rise lands
+
+    # An ending on the next bar line of stage 2's own clock.
+    m = call("/api/gm/music", {"layers": "horologe", "cue": "ending"}, host=True)[1]["music"]
+    assert m["cue"]["id"] == "ending" and m["cue"]["at"] >= m["started_at"]
+
+    # After an ending, the set starts again from the top.
+    again = call("/api/gm/music", {"layers": "horologe", "stage": 1}, host=True)[1]["music"]
+    assert again["id"] > first_id and again["stage"] == "stage1" and "cue" not in again
+
+    for bad in ({"stage": 9}, {"intensity": "loud"}, {"cue": "victory"}, {"via": "break", "stage": 2}):
+        assert call("/api/gm/music", {"layers": "horologe", **bad}, host=True)[0] == 400
+    assert call("/api/gm/music", {"layers": "nobody"}, host=True)[0] == 400
+    assert call("/api/gm/music", {"layers": "horologe"})[0] == 403          # players can't
+
+    # Every page plays the same state, with the engine the page loads.
+    _, info = call(f"/api/info?code={CODE}")
+    assert info["music"]["stage"] == "stage1" and info["music"]["intensity"] == "full"
+    with table["opener"].open(f"{table['base']}/layered-player.js", timeout=5) as resp:
+        assert b"class LayeredPlayer" in resp.read()
+    with table["opener"].open(f"{table['base']}/", timeout=5) as resp:
+        assert b'<script src="/layered-player.js"></script>' in resp.read()
